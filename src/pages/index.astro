---
import Layout from '../layouts/Layout.astro';

import backgroundHero from '../assets/img/hero_background.webp';
const backgroundStyle = `url(${backgroundHero.src})`;
---

<Layout isIndex={true}>
	<!-- Hero -->
	<section class="container-hero-global">
		<div class="container-hero-left">
			<div class="container-divisor">
				<hr class="divisor-animation" style="width: 10px; height: 100%;">
			</div>
			<div class="container-title-hero">
				<h1 class="text-hero title-h1-animation">
					Cauã
				</h1>
				<h1 class="text-hero title-h1-animation">
					Nunes
				</h1>
				<h1 class="text-hero title-h1-animation">
					Novaes
				</h1>
			</div>
		</div>
		<div>
			<div class="container-funcao-hero">
				<h2 class="text-hero title-h2-animation">&lt;Front-End Developer /&gt;</h2>
				<hr class="divisor-animation" style="width: 100%; height: 10px;">
			</div>
		</div>
	</section>

	<!-- About Me -->
	<section class="container-aboutme">

	</section>
</Layout>

<style define:vars={{ backgroundStyle }}>
	/* ============================= HERO ============================= */
	/* \/ Classes padrões para estilização dos textos em geral + Apontamento para Animação GSAP \/ */
	.text-hero {
		width: 100%;
		text-shadow: 0px 0px 70px #f2f2f280;
		text-transform: uppercase;
		text-align: left;
	}
	.title-h1-animation {
		/* \/ Estado inicial para a animação do GSAP \/ */
		opacity: 0;
		transform: translateX(-60px);
	}
	.title-h2-animation {
		/* \/ Estado inicial para a animação do GSAP \/ */
		opacity: 0;
	}
	.divisor-animation {
		/* \/ Estado inicial para a animação do GSAP \/ */
		opacity: 0;
		transform: translateY(30px);
	}


    .container-hero-global {
		background-image: linear-gradient(rgba(0, 0, 0, 0.808), rgba(0, 0, 0, 0)), var(--backgroundStyle);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
        width: 100%;
        height: 100vh;        
        display: flex;
        justify-content: space-around;
        align-items: center;

		/* \/ Estado inicial para a animação do GSAP \/ */
		opacity: 0;
    }

	.container-hero-left {
		display: flex;
		flex-direction: row;
		justify-content: start;
		align-items: stretch;
	}

	.container-divisor {
		margin-right: 6%;
	}

	.container-title-hero {
		width: min-content;
	}
	.container-title-hero .text-hero {
		font-size: 5rem;
	}

	.container-funcao-hero {
		width: min-content;
	}
	.container-funcao-hero .text-hero {
		font-family: var(--fonte-anekdevanagari);
		font-weight: 900;
        font-size: 1.5rem;
	}
	/* ================================================================ */
	
	/* =========================== ABOUT ME =========================== */
	.container-aboutme {
		background-image: linear-gradient(rgb(0, 0, 0), rgba(0, 0, 0, 0)), var(--backgroundStyle);
		transform: rotate(180deg);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
        width: 100%;
        height: 100vh;  
	}
	
	/* ================================================================ */
</style>


<script>
	import { gsap } from "gsap";
	
	/* ============================= HERO ============================= */
	document.addEventListener('CarregamentoCompleto', () => {
		let timeline_hero = gsap.timeline();
		timeline_hero
			.fromTo(".container-hero-global", {opacity: 0,}, {opacity: 1, duration: 1, ease: "power1.in"})
			.fromTo(".divisor-animation", {y: "50%", opacity: 0}, {y: 0, opacity: 1, duration: 1, ease: "power1.inOut"})
			.fromTo(".title-h1-animation", {x: "-6%", opacity: 0}, {x: 0, opacity: 1, duration: 1.5, stagger: 0.4, ease: "power3.out"})
			.fromTo(".title-h2-animation", {y: "50%", opacity: 0}, {y: 0, opacity: 1, duration: 1.5, stagger: 0.4, ease: "power3.out"})
			.to("#container-header", {y: 0, opacity: 1, duration: 2.5, ease: "power1.out"}, "-=0.8");
	});
	/* ================================================================ */
</script>