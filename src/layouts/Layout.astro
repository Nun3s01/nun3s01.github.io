---
import Preloader from '../components/LoaderPage.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro'

interface Props {
	isIndex?: boolean;
}
const { isIndex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="google-site-verification" content="ixmyB2iNY9Rj1-jfXNqaqeYAfqYUPK-PNAbyq07BXjk" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logotipoCNN.svg" />
		<link rel="icon" href="/logotipoCNN.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio | Cauã Nunes Novaes</title>
		<meta name="description" content="Portfólio Profissional, desenvolvido por Cauã Nunes Novaes. Atualmente atua como Desenvolvedor Front-end e Infraestrutura. A cada dia está no caminho para se tornar um Arquiteto de Software. - Technology is EVERYWHERE!" />
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=GT-TXX3VLFQ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'GT-TXX3VLFQ');
		</script>
	</head>
	<body>
		<Preloader slot="fallback"/>
		<Navbar isIndex={isIndex} />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'PoppinsRegular';
		src: url('/fonts/Poppins/Poppins_Regular.ttf') format('truetype');
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: PoppinsBold;
		src: url('/fonts/Poppins/Poppins_Bold.ttf') format('truetype');
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'AnekDevAnagari';
		src: url('/fonts/AnekDevanagari/Anek-Devanagari.ttf') format('truetype');
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}
	
	
	/* Config Lenis */
	html.lenis, html.lenis body {
	height: auto;
	}
	.lenis.lenis-smooth {
	scroll-behavior: auto !important;
	}
	.lenis.lenis-smooth [data-lenis-prevent] {
	overscroll-behavior: contain;
	}
	.lenis.lenis-stopped {
	overflow: hidden;
	}
	.lenis.lenis-smooth iframe {
	pointer-events: none;
	}


	:root {
		--corFundo-padrao: #000000;
		--corTexto-padrao: #f2f2f2;
		--corTitulo-padrao: #f7f7f7;
		
		--fonte-anekdevanagari: 'AnekDevAnagari', sans-serif;
		--fonte-poppins-Regular: 'PoppinsRegular', sans-serif;
		--fonte-poppins-Bold: 'PoppinsBold', sans-serif;
		--espacamento-padrao: 0.35rem;
	}

	html, body {
		padding: 0;
		margin: 0;
		width: 100%;
		min-height: 100vh;
		box-sizing: border-box;
		font-family: var(--fonte-anekdevanagari);
		background-color: var(--corFundo-padrao);
		color: var(--corTexto-padrao);
	}

	h1, h2, h3, h4 {
		margin: 0;
		padding: 0;
		font-family: var(--fonte-poppins-Bold);
		color: var(--corTitulo-padrao);
		letter-spacing: var(--espacamento-padrao);
		width: min-content;
		text-align: center;
		white-space: nowrap;
	}

	p {
		margin: 0;
		padding: 0;
	}

    a {
        font-family: var(--fonte-poppins-Bold);
        font-size: 0.9rem;
        text-transform: uppercase;
        color: #f2f2f2;
        text-decoration: none;
		text-align: center;
		text-shadow: 0px 0px 70px #f2f2f280;
    }

	/* Para definir uma <hr> é necessário passar as medidas de tamanho [width e height ] diretamente a tag html (style="") */
	hr {
		margin: 0;
		padding: 0;
		background-color: transparent;
		box-shadow: 0 1px 10px #0d0d0d;
		backdrop-filter: blur(10px);
		border: none;
		border-radius: 110px;
	}

	.linkIcon-padrao { /* Definição da cor dos icons aqui */
        color: #f2f2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.3s ease;
	}
	.linkIcon-padrao:hover { /* Feedback de "selecionado" aos icons */
        color: #7c7c7c;
	}
</style>

<script>
	import Lenis from 'lenis';
	import { gsap } from 'gsap';

	const lenis = new Lenis({
		duration: 1.2, // Inércia de Scrollagem.
		easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
		smoothWheel: true,
	});
	
	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});
	gsap.ticker.lagSmoothing(0);
</script>