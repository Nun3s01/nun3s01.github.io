---
import Preloader from '../components/sections/LoaderPage.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro'

interface Props {
	isIndex?: boolean;
}
const { isIndex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="google-site-verification" content="ixmyB2iNY9Rj1-jfXNqaqeYAfqYUPK-PNAbyq07BXjk" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="canonical" href="https://nun3s01.github.io/"/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio | Cauã Nunes Novaes</title>
		<meta name="description" content="Portfólio Profissional, desenvolvido por Cauã Nunes Novaes. Atualmente atua como Desenvolvedor Front-end e Infraestrutura. A cada dia está no caminho para se tornar um Arquiteto de Software. - Technology is EVERYWHERE!" />
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-5PWJVSL7');</script>
